{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "error",
    "no-undef": "error",
    "semi": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["server.js", "seed.js", "config/db.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
